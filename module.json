{
  "schema": "lifeplanner.module.v2",
  "id": "fpm",
  "name": "FPM - Fountain Pen Manager",
  "version": "1.2.0",
  "description": "Füller, Tinten, Federn, Papier, Rotation und Sammlungswissen.",
  "requires_host": ">=0.5.15,<0.6",
  "source_entry": "main.py",
  "windows_executable": "FountainPenManager/FountainPenManager.exe",
  "linux_executable": "FountainPenManager/FountainPenManager",
  "permissions": [
    "own_data_read",
    "own_data_write",
    "bridge_read",
    "bridge_write",
    "network_optional"
  ],
  "environment": {
    "FPM_DATA_DIR": "{module_data_dir}",
    "LIFEPLANNER_MODULE_DATA_DIR": "{module_data_dir}",
    "LIFEPLANNER_BRIDGE_DIR": "{bridge_dir}",
    "LIFEPLANNER_CENTRAL_UPDATER": "1"
  },
  "bridge": {
    "publishes": [
      {
        "name": "FPM → BudgetManager",
        "file": "fpm_to_budgetmanager.jsonl",
        "schemas": ["budgetmanager.import.v1"]
      }
    ],
    "subscribes": [
      {
        "name": "BudgetManager → FPM",
        "file": "budgetmanager_to_fpm.jsonl",
        "schemas": ["fpm.import.v1", "fpm.expense.v1"]
      },
      {
        "name": "Sparziele → FPM",
        "file": "budgetmanager_savings_goals.jsonl",
        "schemas": ["fpm.savings-goal.v1", "fpm.savings_goal.v1"]
      }
    ]
  }
}
